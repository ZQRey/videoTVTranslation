<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная полноэкранная темная тема для Android TV и мобильных устройств -->
    <style name="Theme.StreamClient" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_emerald</item>
        <item name="colorPrimaryVariant">@color/brand_emerald_dark</item>
        <item name="colorOnPrimary">@color/text_dark</item>
        <item name="colorSecondary">@color/brand_emerald_light</item>
        <item name="colorOnSecondary">@color/text_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Стиль диалогового окна настроек -->
    <style name="Theme.StreamClient.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.85</item>
    </style>
</resources>
