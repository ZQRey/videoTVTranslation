<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Полноэкранный Media3 PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Верхний оверлей HUD: статус трансляции и кнопка настроек -->
    <LinearLayout
        android:id="@+id/hudTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_gradient"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:gravity="center_vertical">

        <!-- Бейдж статуса эфира -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/ic_tv"
                android:backgroundTint="@color/status_live" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/status_playing"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Адрес текущего потока -->
        <TextView
            android:id="@+id/tvStreamUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="rtsp://192.168.1.100:8554/live" />

        <!-- Кнопка вызова настроек с поддержкой пульта ДУ -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_secondary_focused"
            android:contentDescription="@string/btn_settings"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Индикатор первичной буферизации / подключения -->
    <ProgressBar
        android:id="@+id/progressBuffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand_emerald"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Панель аварии / Reconnect Loop оверлей -->
    <com.example.streamclient.ui.view.FocusableConstraintLayout
        android:id="@+id/errorOverlay"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_dark"
        android:padding="28dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/status_error_title"
            android:textColor="@color/status_error"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivErrorIcon" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/status_reconnecting_format"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvErrorTitle"
            tools:text="Потеряно соединение с сервером. Повторная попытка через 3 сек…" />

        <!-- Кнопки управления при ошибке -->
        <LinearLayout
            android:id="@+id/errorButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvErrorMessage">

            <Button
                android:id="@+id/btnRetryNow"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_focused"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_retry"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnErrorSettings"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary_focused"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_settings"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

    </com.example.streamclient.ui.view.FocusableConstraintLayout>

    <!-- Оверлей спящего режима (Standby / Расписание): сплошной черный экран -->
    <FrameLayout
        android:id="@+id/standbyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
