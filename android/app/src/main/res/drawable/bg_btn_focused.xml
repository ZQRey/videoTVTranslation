<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Состояние фокуса (D-Pad курсор пульта ДУ) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_emerald" />
            <stroke
                android:width="2.5dp"
                android:color="@color/text_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Состояние нажатия -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_emerald_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Обычное состояние по умолчанию -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_emerald_dark" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_emerald" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
