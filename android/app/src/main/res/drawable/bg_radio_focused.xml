<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Выбранный и в фокусе пульта -->
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_emerald" />
            <stroke
                android:width="2.5dp"
                android:color="@color/text_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Выбранный -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_emerald_dark" />
            <stroke
                android:width="1.5dp"
                android:color="@color/brand_emerald" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Не выбранный, но в фокусе пульта -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_normal" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_emerald" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Не выбранный и без фокуса -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <stroke
                android:width="1dp"
                android:color="@color/bg_input_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
